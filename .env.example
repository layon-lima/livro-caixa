# Copie para .env (NUNCA comite o arquivo .env).
# Configure uma senha forte antes de iniciar os contêineres.
POSTGRES_DB=livro_caixa
POSTGRES_USER=livro_caixa
POSTGRES_PASSWORD=
CADDY_NETWORK=gfarm_proxy

# Armazenamento privado R2 — configure somente com credenciais próprias.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Chave opcional para interpretar documentos ambíguos e separar vários documentos de um PDF.
# Sem ela o OCR local funciona e gera uma proposta básica por arquivo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
